# ==============================================================================
# SMARTKHATA AI - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Client-Side Supabase Configuration (Exposed to browser via Vite - Safe with RLS)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# Supabase Edge Functions / Backend Secrets (NEVER expose in client-side code!)
# Configure these using `supabase secrets set ...` or inside the Supabase Dashboard
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# OpenAI API Key (For intent classification, entity extraction, and structured output)
OPENAI_API_KEY=your-openai-api-key

# Gnani.ai Prisma v3.0 (Speech-to-Text STT)
GNANI_PRISMA_API_KEY=your-gnani-prisma-api-key
GNANI_PRISMA_ACCESS_TOKEN=your-gnani-prisma-access-token
GNANI_PRISMA_ENDPOINT=https://api.gnani.ai/v3/asr

# Gnani.ai Timbre v3.0 (Text-to-Speech TTS)
GNANI_TIMBRE_API_KEY=your-gnani-timbre-api-key
GNANI_TIMBRE_ACCESS_TOKEN=your-gnani-timbre-access-token
GNANI_TIMBRE_ENDPOINT=https://api.gnani.ai/v3/tts
